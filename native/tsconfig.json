{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": ["jest"]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "simulator-smoke.tsx",
    "simulator-connected-smoke.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
