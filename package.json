{
  "name": "openjob",
  "version": "0.3.7",
  "private": true,
  "bin": {
    "openjob": "cli/openjob.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "npm --prefix native ci",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prototype:assignee-columns": "OPENJOB_ASSIGNEE_COLUMNS_PROTOTYPE=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prototype:cli": "node prototypes/cli/openjob.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "cli:types": "openapi-typescript openapi/openapi.yaml -o cli/generated/openapi.d.ts",
    "cli:types:check": "openapi-typescript openapi/openapi.yaml -o cli/generated/openapi.d.ts --check",
    "cli:pack": "npm pack ./cli",
    "cli:smoke:production": "node scripts/smoke-cli-production.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "release:candidate": "node scripts/release-candidate.mjs",
    "deploy": "node scripts/release.mjs deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview vinext deploy",
    "deploy:raw": "vinext deploy",
    "firebase:deploy:rules": "npx -y firebase-tools@latest deploy --only firestore --project openjob-dev",
    "openapi:check": "node scripts/validate-openapi.mjs",
    "privacy:generate": "node scripts/release-privacy.mjs generate",
    "privacy:check": "node scripts/release-privacy.mjs check",
    "verify": "node scripts/verify.mjs",
    "test:api": "node --test tests/v1-*.test.mjs tests/firestore.test.mjs tests/openapi-contract.test.mjs tests/task-push-dispatcher.test.mjs tests/web-push.test.mjs tests/notification-service-worker.test.mjs",
    "test:cli": "node --test tests/cli*.test.mjs",
    "test:verification": "node --test tests/verification.test.mjs tests/release-candidate.test.mjs",
    "test:deterministic": "npm run brand:check && npm run build && npm run cli:types:check && tsc --noEmit && npm run native:quick && node --test tests/*.test.mjs && npm run test:browser",
    "test": "npm run test:deterministic && npm run secret:check",
    "test:browser": "node scripts/test-browser.mjs",
    "secret:check": "node scripts/check-v1-secrets.mjs",
    "legacy:smoke": "node scripts/legacy-cutover.mjs smoke",
    "legacy:snapshot": "node scripts/legacy-cutover.mjs snapshot",
    "legacy:retire": "node scripts/legacy-cutover.mjs retire",
    "qa:user:provision": "node scripts/provision-qa-password-user.mjs",
    "qa:fixture:reset": "node scripts/reset-qa-fixture.mjs",
    "smoke:production": "node scripts/smoke-v1-production.mjs",
    "native:check": "npm --prefix native run check",
    "native:quick": "npm --prefix native run lint && npm --prefix native run typecheck && npm --prefix native test",
    "native:simulators": "npm --prefix native run simulators",
    "cf:typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv",
    "brand:assets": "node scripts/brand-assets.mjs",
    "brand:check": "node scripts/brand-assets.mjs --check",
    "typecheck": "npm run cf:typegen && tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:workspace": "node scripts/dev-workspace.mjs",
    "workspace:cli": "node cli/workspace.mjs",
    "dev:personal-workspace": "node scripts/dev-personal-workspace.mjs",
    "app:build": "node scripts/build-npm-app.mjs local",
    "app:pack": "npm run app:build && npm pack ./dist/npm --pack-destination ./dist",
    "test:distribution": "node --test tests/npm-distribution.test.mjs",
    "npm:prepare": "node scripts/npm-publication.mjs prepare",
    "npm:publish": "node scripts/npm-publication.mjs publish",
    "npm:resume:check": "node scripts/npm-approved-publication.mjs check",
    "npm:resume": "node scripts/npm-approved-publication.mjs publish",
    "test:google-local": "node --test tests/google-local-integration.test.mjs",
    "test:portable": "node --test tests/portable-service.test.mjs",
    "server:bundle": "node scripts/prepare-server-bundle.mjs",
    "dev:owned-workspaces": "node scripts/dev-owned-workspaces.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@pushforge/builder": "2.0.5",
    "firebase": "12.16.0",
    "google-auth-library": "11.3.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "openapi-typescript": "7.13.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "yaml": "2.9.0"
  },
  "type": "module"
}
