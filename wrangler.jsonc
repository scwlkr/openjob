{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openjob",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "openjob-dev",
    "FIREBASE_API_KEY": "AIzaSyCnk2KPwHgRu0dhJcy6QDow-hI_rEBTHaU",
    "APPLE_ACCOUNT_DELETION_CLIENT_IDS": "dev.openjob.app,dev.openjob.auth",
    "APPLE_ACCOUNT_DELETION_SERVICE_ID": "dev.openjob.auth",
    "APPLE_ACCOUNT_DELETION_REDIRECT_URI": "https://openjob-dev.firebaseapp.com/__/auth/handler",
    "GOOGLE_ACCOUNT_DELETION_CLIENT_IDS": "1015996869029-8jjj5dttgi3iea9geo9nt9lh7q7e631f.apps.googleusercontent.com,1015996869029-tlko5334fhqiodcgebd5hncf41jh2f8m.apps.googleusercontent.com,1015996869029-qr0bkpihst84f8coibaotbtpjngicmjq.apps.googleusercontent.com",
    "GOOGLE_OAUTH_CLIENT_ID": "1015996869029-7rsl506o6gc6sg9d7l5kl6ant3q1t4cb.apps.googleusercontent.com",
    "OPENJOB_RUNTIME_TIER": "production"
  },
  "env": {
    "preview": {
      "name": "openjob-preview",
      "routes": [],
      "vars": {
        "FIREBASE_PROJECT_ID": "openjob-nonprod",
        "FIREBASE_API_KEY": "AIzaSyDcONX1KOS-mIg5koGzh5saWHZCf5-HISo",
        "APPLE_ACCOUNT_DELETION_CLIENT_IDS": "dev.openjob.app.preview,dev.openjob.auth.nonprod",
        "APPLE_ACCOUNT_DELETION_SERVICE_ID": "dev.openjob.auth.nonprod",
        "APPLE_ACCOUNT_DELETION_REDIRECT_URI": "https://openjob-nonprod.firebaseapp.com/__/auth/handler",
        "GOOGLE_ACCOUNT_DELETION_CLIENT_IDS": "550998178053-5fivrj3rggm6ttmg3sesiupsahk14dus.apps.googleusercontent.com,550998178053-nek4ph7nn98c7f1r4vjo1jnvd11nvm4q.apps.googleusercontent.com,550998178053-5681l7oet4q3rq0okoa2caqkv4bh324t.apps.googleusercontent.com,550998178053-5ruvfa2pemb5imm1ke195qrvftrsrm6j.apps.googleusercontent.com,550998178053-n1s9vp0cbmqubh5onint23j8415ivkoa.apps.googleusercontent.com",
        "GOOGLE_OAUTH_CLIENT_ID": "550998178053-t47ol37o4hu6e8gte63r79oj52vn4u94.apps.googleusercontent.com",
        "OPENJOB_QA_PASSWORD_TENANT_ID": "OpenJob-QA-Two-mvz9m",
        "OPENJOB_RUNTIME_TIER": "preview"
      },
      "workers_dev": true
    }
  },
  "routes": [
    { "pattern": "openjob.dev", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true }
}
