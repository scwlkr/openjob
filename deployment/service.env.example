# Blank inputs only; use separately authorized existing development configuration.
# Never commit actual private values or copy business infrastructure configuration.
OPENJOB_PUBLIC_ORIGIN=http://127.0.0.1:5192
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APPLE_SIGN_IN_SERVICE_ID=
# Disabled by default. Source prep only; no approval to deliver credentials/start.
OPENJOB_GOOGLE_CONNECTIONS_MODE=disabled
OPENJOB_GOOGLE_CLIENT_ID=
OPENJOB_GOOGLE_OWNER_USER_ID=
OPENJOB_GOOGLE_OWNER_FIREBASE_UID=
OPENJOB_GOOGLE_MAILBOX=
OPENJOB_GOOGLE_KEY_ID=
# Optional Compose overlay source paths; contents never belong in this file.
OPENJOB_GOOGLE_CLIENT_SECRET_SOURCE=
OPENJOB_GOOGLE_KEY_SOURCE=
# Direct Node opt-in uses absolute *_FILE paths instead of Compose source paths.
OPENJOB_GOOGLE_CLIENT_SECRET_FILE=
OPENJOB_GOOGLE_KEY_FILE=
