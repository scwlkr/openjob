      "status": "live",
      "url": "https://openjob.dev/account-deletion",
      "implementationIssue": 42
    },
    "support": {
      "displayName": "Public support",
      "requiredBeforeSubmission": true,
      "status": "live",
      "url": "https://openjob.dev"
    }
  },
  "accountDeletion": {
    "requiredByStore": true,
    "status": "implemented",
    "publicUrlId": "accountDeletion",
    "implementationIssue": 42,
    "inAppAvailable": true,
    "publicRequestAvailable": true,
    "accessEnds": "immediate",
    "maximumRetryDays": 7,
    "retentionAfterCompletion": "none",
    "soleMemberGroup": "end",
    "sharedGroupMembership": "remove",
    "finalAdminReplacement": "longest-tenured-stable-tie-break",
    "creatorTasks": "delete",
    "openAssignedTasks": "unassigned",
    "doneAssignedTasks": "deleted-user-marker-without-identity",
    "linkedProviderCleanup": "revoke-before-completion",
    "pendingState": "minimal-encrypted-retry-job"
  },
