  "thirdPartyEvidence": [
    {
      "id": "google-signin-apple-sdk-manifest",
      "displayName": "GoogleSignIn Apple SDK privacy manifest",
      "processorId": "google-signin",
      "platform": "ios",
      "sourceType": "sdk-manifest",
      "claims": [
        "Linked Phone Number and Coarse Location for App Functionality",
        "Linked Other Data Types and User ID for App Functionality and Analytics",
        "Linked Device ID and Other Usage Data for Analytics"
      ],
      "representsOpenJobBehavior": false,
      "candidateReconciliationRequired": true
    },
    {
      "id": "apple-operating-system-quality",
      "displayName": "Apple operating-system quality declarations",
      "processorId": "apple-os-quality",
      "platform": "ios",
      "sourceType": "operating-system-report",
      "claims": [
        "Independent operating-system safety signals are not OpenJob app-level diagnostics"
      ],
      "representsOpenJobBehavior": false,
      "candidateReconciliationRequired": true
    },
    {
      "id": "google-play-sdk-index",
      "displayName": "Google Play SDK Index declarations",
      "processorId": "google-play-quality",
      "platform": "android",
      "sourceType": "sdk-index",
      "claims": [
        "SDK Index findings remain candidate evidence and do not define OpenJob behavior"
      ],
      "representsOpenJobBehavior": false,
      "candidateReconciliationRequired": true
    }
  ],
  "evidencePolicy": {
    "canAddDiscrepancy": true,
    "canRewriteInventory": false,
    "inputs": [
      {
        "id": "exact-dependency-inventories",
        "displayName": "Exact signed iOS and Android dependency inventories",
        "sourceType": "exact-dependency-inventory",
        "candidateScoped": true
      },
      {
        "id": "bundled-sdk-manifests",
        "displayName": "Bundled SDK privacy manifests",
        "sourceType": "sdk-manifest",
        "candidateScoped": true
      },
      {
        "id": "play-sdk-index",
        "displayName": "Play SDK Index entries",
        "sourceType": "sdk-index",
        "candidateScoped": true
      },
      {
        "id": "captured-provider-api-sentry-traffic",
        "displayName": "Captured provider, API, and Sentry traffic",
        "sourceType": "captured-traffic",
        "candidateScoped": true
      }
    ],
    "prohibitedContent": [
      { "id": "credentials", "displayName": "credentials" },
      { "id": "authentication-material", "displayName": "authentication material" },
      { "id": "personal-data", "displayName": "personal data" },
      { "id": "task-content", "displayName": "Task content" },
      { "id": "group-content", "displayName": "Group content" }
    ]
  },
  "submissionChecklist": [
    {
      "id": "match-generated-projections",
      "platforms": ["apple", "play"],
      "description": "Match store answers to the generated projections and record this inventory fingerprint.",
      "blockingCondition": "Any generated projection is stale or manually diverged."
    },
    {
      "id": "verify-public-urls",
      "platforms": ["apple", "play"],
      "description": "Verify every required public URL is live at its exact inventory URL.",
      "blockingCondition": "A required URL is planned, absent, redirected incorrectly, or unavailable."
    },
    {
      "id": "verify-account-deletion",
      "platforms": ["apple", "play"],
      "description": "Verify the implemented in-app and public account-deletion behavior from issue #42.",
      "blockingCondition": "Account deletion remains pending or differs from the inventory."
    },
    {
      "id": "reconcile-candidate-evidence",
      "platforms": ["apple", "play"],
      "description": "Reconcile exact dependencies, SDK declarations, and captured traffic against the immutable candidate.",
      "blockingCondition": "Any evidence discrepancy is unexplained."
    },
    {
      "id": "save-without-premature-claims",
      "platforms": ["apple", "play"],
      "description": "Save or submit answers only through the authenticated store surface after all blockers clear.",
      "blockingCondition": "The candidate, traffic, deletion, URL, or declaration proof is incomplete."
    }
  ]
