      "id": "ios-apple-sign-in-entitlement",
      "displayName": "Sign in with Apple entitlement",
      "platform": "ios",
      "disposition": "required",
      "processorIds": ["apple-signin"],
      "nativeConfiguration": {
        "kind": "ios-entitlement",
        "key": "com.apple.developer.applesignin",
        "value": ["Default"]
