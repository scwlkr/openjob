  "publicUrls": {
    "privacyPolicy": {
      "displayName": "Privacy policy",
      "requiredBeforeSubmission": true,
      "status": "live",
      "url": "https://openjob.dev/privacy",
      "implementationIssue": 40
    },
    "accountDeletion": {
      "displayName": "Account deletion request",
